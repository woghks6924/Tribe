generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  SOLD_OUT
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
  PARTIALLY_CANCELLED
  FAILED
}

enum PaymentStatus {
  READY
  PAID
  FAILED
  CANCELLED
  PARTIALLY_CANCELLED
}

enum PgProvider {
  TOSSPAYMENTS
  NAVERPAY
}

enum PaymentMethod {
  CARD
  EASY_PAY
  VIRTUAL_ACCOUNT
  TRANSFER
  NAVER_PAY
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model Customer {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String? // 소셜 로그인 전용 계정은 비밀번호가 없을 수 있다
  name          String
  phone         String?
  emailVerified DateTime?

  naverId String? @unique // 네이버 로그인으로 가입/연동한 계정의 네이버 고유 ID

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  name         String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique
  type      TokenType
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([email, type])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  imageUrl  String?
  sortOrder Int       @default(0)
  products  Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  description    String // 목록/카드용 짧은 요약
  price          Int // KRW, 원 단위 정수
  compareAtPrice Int?
  status         ProductStatus @default(ACTIVE)

  // 상세페이지 탭 콘텐츠 (리치 텍스트 에디터로 작성, HTML 저장)
  infoContent   String? // 제품 정보
  sizeContent   String? // 사이즈 정보
  detailContent String? // 상세 정보 (착용샷/제품컷 등 이미지 삽입 가능)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  images     ProductImage[]
  options    ProductOption[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String // Supabase Storage public URL
  alt       String?
  sortOrder Int     @default(0)

  @@index([productId])
}

model ProductOption {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  size      String // 예: S, M, L, XL
  color     String // 예: Black
  colorHex  String? // 스와치 표시용
  sku       String  @unique
  stock     Int     @default(0)
  priceDiff Int     @default(0) // 옵션별 추가금액

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, size, color])
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique // 포트원 paymentId로 사용
  status      OrderStatus @default(PENDING_PAYMENT)

  customerId String? // 로그인 없이도 주문 가능하도록 nullable (게스트 주문 유지)
  customer   Customer? @relation(fields: [customerId], references: [id])

  customerName  String
  customerEmail String
  customerPhone String

  zipCode      String
  address1     String
  address2     String?
  shippingMemo String?

  trackingNumber String?
  carrier        String?

  subtotal    Int
  shippingFee Int @default(0)
  discount    Int @default(0)
  promoCode   String?
  totalAmount Int

  items   OrderItem[]
  payment Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  productOptionId String
  productOption   ProductOption @relation(fields: [productOptionId], references: [id])

  // 주문 시점 스냅샷 (상품 정보가 나중에 바뀌어도 주문 내역 유지)
  productName String
  optionLabel String // 예: "L / Black"
  unitPrice   Int
  quantity    Int
  lineTotal   Int

  @@index([orderId])
}

model Payment {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  pgProvider PgProvider
  channelKey String // 포트원 채널키 (토스/네이버페이 구분)
  method     PaymentMethod?
  status     PaymentStatus  @default(READY)

  paymentId String  @unique // 포트원 결제 요청 시 사용한 고유 ID (=orderNumber)
  pgTxId    String? // 포트원/PG사 내부 거래 ID (취소 API 호출 시 필요)

  requestedAmount Int
  paidAmount      Int?
  currency        String @default("KRW")

  receiptUrl String?
  approvedAt DateTime?

  failReason String?

  cancelledAmount Int       @default(0)
  cancelReason    String?
  cancelRequester String? // extra.requester (네이버페이 취소 시 필수)
  cancelledAt     DateTime?

  raw Json? // 포트원 응답 원본 저장(감사/디버깅용)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PromoCode {
  id            String       @id @default(cuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Int // PERCENTAGE: 1-100, FIXED: 원 단위 정액 할인
  active        Boolean      @default(true)
  expiresAt     DateTime?
  minOrderAmount Int?
  usageLimit    Int?
  usedCount     Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 상품별이 아닌 사이트 전체에 한 번만 적용되는 콘텐츠(배송/교환 정책 등).
// 항상 단일 행만 존재한다고 가정하고 upsert로 관리한다.
model SiteSettings {
  id                     String @id @default("singleton")
  shippingReturnsContent String @default("")

  updatedAt DateTime @updatedAt
}

// 사이트 공지사항. popupEnabled인 항목은 고객단 첫 진입 시 팝업으로 노출된다.
model Notice {
  id            String    @id @default(cuid())
  title         String
  content       String // 리치 텍스트 에디터로 작성한 HTML
  imageUrl      String?
  linkUrl       String?
  popupEnabled  Boolean   @default(true)
  active        Boolean   @default(true)
  startAt       DateTime?
  endAt         DateTime?
  sortOrder     Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 룩북 페이지의 에디토리얼 사진. 노출 순서는 sortOrder를 따르고,
// 화면에 표시되는 "LOOK 0N" 번호는 이 순서를 기준으로 렌더링 시 계산한다.
model LookbookPhoto {
  id        String  @id @default(cuid())
  imageUrl  String
  caption   String
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 메인 페이지 히어로/영상 슬라이드쇼가 공유하는 영상 풀.
// 히어로는 sortOrder가 가장 앞선 active 영상 1개를, 슬라이드쇼는 active 전체를 순서대로 사용한다.
model BannerVideo {
  id         String  @id @default(cuid())
  videoUrl   String
  label      String?
  brightness Float   @default(1.3)
  active     Boolean @default(true)
  sortOrder  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
