generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  SOLD_OUT
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
  PARTIALLY_CANCELLED
  FAILED
}

enum PaymentStatus {
  READY
  PAID
  FAILED
  CANCELLED
  PARTIALLY_CANCELLED
}

enum PgProvider {
  TOSSPAYMENTS
  NAVERPAY
}

enum PaymentMethod {
  CARD
  EASY_PAY
  VIRTUAL_ACCOUNT
  TRANSFER
  NAVER_PAY
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum StudioTheme {
  LIGHT
  DARK
}

enum StudioInquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

model Customer {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String? // 소셜 로그인 전용 계정은 비밀번호가 없을 수 있다
  name          String
  phone         String?
  emailVerified DateTime?

  naverId String? @unique // 네이버 로그인으로 가입/연동한 계정의 네이버 고유 ID

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  name         String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique
  type      TokenType
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([email, type])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  imageUrl  String?
  sortOrder Int       @default(0)
  products  Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  description    String // 목록/카드용 짧은 요약
  price          Int // KRW, 원 단위 정수
  compareAtPrice Int?
  status         ProductStatus @default(ACTIVE)

  // 상세페이지 탭 콘텐츠 (리치 텍스트 에디터로 작성, HTML 저장)
  infoContent   String? // 제품 정보
  sizeContent   String? // 사이즈 정보
  detailContent String? // 상세 정보 (착용샷/제품컷 등 이미지 삽입 가능)

  // 목록/카드 전용 썸네일. 비어 있으면 images의 첫 번째 사진으로 대체된다.
  thumbnailUrl String?

  // 기능성 스펙 (Bandit Running류 "Tech Specs" 블록)
  fitType          String? // 예: Compression, Relaxed
  pocketing        String? // 예: "4 gel, 3 phone"
  tempMin          Int? // 착용 권장 온도 범위(°C), -10~35 스케일 위에 표시
  tempMax          Int?
  effortMin        Int? // 착용 권장 운동 강도 범위(%), 0~100 스케일 위에 표시
  effortMax        Int?
  materials        String? // 예: "78% Polyester, 24% Spandex"
  careInstructions String[] @default([]) // 고정 보기 목록 중 다중 선택
  careNote         String?
  madeIn           String?
  purposeTags      String[] @default([]) // 예: Running, Road Race, Competition, Daily Wear, Gym Training

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  images          ProductImage[]
  options         ProductOption[]
  orderItems      OrderItem[]
  functionalities ProductFunctionality[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

// 상품마다 반복 사용되는 "기능성" 카드 라이브러리 (아이콘 + 제목 + 설명).
// 관리자는 여기서 미리 만들어두고, 상품별로 해당하는 항목만 선택해서 노출한다.
model Functionality {
  id          String  @id @default(cuid())
  title       String
  description String
  icon        String? // Supabase Storage에 업로드한 아이콘 이미지 URL

  products ProductFunctionality[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductFunctionality {
  productId       String
  functionalityId String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  functionality   Functionality @relation(fields: [functionalityId], references: [id], onDelete: Cascade)

  @@id([productId, functionalityId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String // Supabase Storage public URL
  alt       String?
  sortOrder Int     @default(0)

  @@index([productId])
}

model ProductOption {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  size      String // 예: S, M, L, XL
  color     String // 예: Black
  colorHex  String? // 스와치 표시용
  sku       String  @unique
  stock     Int     @default(0)
  priceDiff Int     @default(0) // 옵션별 추가금액

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, size, color])
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique // 포트원 paymentId로 사용
  status      OrderStatus @default(PENDING_PAYMENT)

  customerId String? // 로그인 없이도 주문 가능하도록 nullable (게스트 주문 유지)
  customer   Customer? @relation(fields: [customerId], references: [id])

  customerName  String
  customerEmail String
  customerPhone String

  zipCode      String
  address1     String
  address2     String?
  shippingMemo String?

  trackingNumber String?
  carrier        String?

  subtotal    Int
  shippingFee Int @default(0)
  discount    Int @default(0)
  promoCode   String?
  totalAmount Int

  items   OrderItem[]
  payment Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  productOptionId String
  productOption   ProductOption @relation(fields: [productOptionId], references: [id])

  // 주문 시점 스냅샷 (상품 정보가 나중에 바뀌어도 주문 내역 유지)
  productName String
  optionLabel String // 예: "L / Black"
  unitPrice   Int
  quantity    Int
  lineTotal   Int

  @@index([orderId])
}

model Payment {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  pgProvider PgProvider
  channelKey String // 포트원 채널키 (토스/네이버페이 구분)
  method     PaymentMethod?
  status     PaymentStatus  @default(READY)

  paymentId String  @unique // 포트원 결제 요청 시 사용한 고유 ID (=orderNumber)
  pgTxId    String? // 포트원/PG사 내부 거래 ID (취소 API 호출 시 필요)

  requestedAmount Int
  paidAmount      Int?
  currency        String @default("KRW")

  receiptUrl String?
  approvedAt DateTime?

  failReason String?

  cancelledAmount Int       @default(0)
  cancelReason    String?
  cancelRequester String? // extra.requester (네이버페이 취소 시 필수)
  cancelledAt     DateTime?

  raw Json? // 포트원 응답 원본 저장(감사/디버깅용)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PromoCode {
  id            String       @id @default(cuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Int // PERCENTAGE: 1-100, FIXED: 원 단위 정액 할인
  active        Boolean      @default(true)
  expiresAt     DateTime?
  minOrderAmount Int?
  usageLimit    Int?
  usedCount     Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 상품별이 아닌 사이트 전체에 한 번만 적용되는 콘텐츠(배송/교환 정책 등).
// 항상 단일 행만 존재한다고 가정하고 upsert로 관리한다.
model SiteSettings {
  id                     String @id @default("singleton")
  shippingReturnsContent String @default("")

  // 메인 페이지 각 섹션에 들어가는 문구. 줄바꿈(\n)은 렌더링 시 <br/>로 표시한다.
  heroBadgeText  String @default("#TRIBERUN")
  heroHeadline   String @default("One Tribe.\nEndless Tries.")
  heroSubtext    String @default("Runningwear for those who run the city at night. Tri.be — one tribe, built by runners who believe in the repeat, not the record.")

  storyLabel    String @default("FIG. 01 — Philosophy")
  storyHeadline String @default("Not the perfect run.\nThe endless next one.")
  storyBody     String @default("Runners forged by repetition, not perfection, on the street. Tri.be was built for runners who believe in the repeat over the record — one tribe, running the same pace together.")

  crewLabel    String @default("FIG. 02 — Crew")
  crewHeadline String @default("Run alone, it's a jog.\nRun together, it's a tribe.")
  crewBody     String @default("Every Tuesday night, the Tri.be run club crosses the city. Every pace is different — the finish line is always together.")
  crewCta      String @default("JOIN THE TRIBE")

  newsletterHeadline String @default("Join the Tribe")
  newsletterBody     String @default("Every Tuesday, get run club news and new product previews first.")

  // STUDIO(콘텐츠 프로덕션 서비스) 섹션 — 아직 방향 미확정이라 기본값은 비노출.
  showStudioTab      Boolean     @default(false)
  studioTheme        StudioTheme @default(LIGHT)
  studioHeroHeadline String      @default("We shoot the sessions that make people want to run.")

  // 쇼핑몰 전체(스튜디오 제외) 테마. 방문자 브라우저 설정과 무관하게 관리자가 정한 값이 전역 적용된다.
  siteTheme StudioTheme @default(DARK)

  updatedAt DateTime @updatedAt
}

// 사이트 공지사항. popupEnabled인 항목은 고객단 첫 진입 시 팝업으로 노출된다.
model Notice {
  id            String    @id @default(cuid())
  title         String
  content       String // 리치 텍스트 에디터로 작성한 HTML
  imageUrl      String?
  linkUrl       String?
  popupEnabled  Boolean   @default(true)
  active        Boolean   @default(true)
  startAt       DateTime?
  endAt         DateTime?
  sortOrder     Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 룩북 페이지의 에디토리얼 사진. 노출 순서는 sortOrder를 따르고,
// 화면에 표시되는 "LOOK 0N" 번호는 이 순서를 기준으로 렌더링 시 계산한다.
model LookbookPhoto {
  id        String  @id @default(cuid())
  imageUrl  String
  caption   String
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum BannerMediaType {
  VIDEO
  IMAGE
}

// 메인 페이지 히어로/배너 슬라이드쇼가 공유하는 미디어 풀 (영상·사진 혼합 가능).
// 히어로는 sortOrder가 가장 앞선 active 슬라이드 1개를, 슬라이드쇼는 active 전체를 순서대로 사용한다.
model BannerSlide {
  id         String          @id @default(cuid())
  mediaType  BannerMediaType
  mediaUrl   String
  label      String?
  brightness Float           @default(1.3)
  durationSec Int? // 비워두면 영상은 끝날 때, 사진은 5초 후 자동으로 다음 슬라이드로 전환
  active     Boolean         @default(true)
  sortOrder  Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// STUDIO 섹션 포트폴리오 그리드에 노출되는 콘텐츠 항목.
model StudioPortfolioItem {
  id        String  @id @default(cuid())
  title     String
  imageUrl  String
  videoUrl  String?
  category  String // 예: 트랙 WOD, HYROX, VO2max, Run & Swim
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// STUDIO 문의 폼 제출 내역.
model StudioInquiry {
  id              String              @id @default(cuid())
  brandName       String
  contactName     String
  contactInfo     String // 이메일 또는 전화번호
  packageInterest String?
  message         String
  status          StudioInquiryStatus @default(NEW)

  createdAt DateTime @default(now())
}
